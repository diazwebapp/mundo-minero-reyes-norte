---
import { supabaseClient } from '../../../lib/supabase';
import Layout from '../../../layouts/Layout.astro';
import { getMediaPermalink, getPermalink } from '../../../utils/config';
import type { Categoria, Producto } from '../../../local-data/database.types';
import type { ProductItemListSchema } from '../../../local-data/schemas';
import { getImage } from 'astro:assets';
import ReplacementCard from '../../../components/ReplacementCard.astro';


//OPTENEMOS LA SUBCATEGORIA ACTUAL
const { subCategoria } = Astro.params;
const currentCatSlug = subCategoria?.replace(/^\//, '') || '';

const { data: currentCategory, error: dataError } = await supabaseClient
  .from('categorias')
  .select('*')
  .eq('slug', currentCatSlug)
  .single();

/* if (dataError || !currentCategory) {
  return Astro.redirect('/404');
} */
const categoria:Categoria = currentCategory;

//OBTENEMOS LA CATEGORIA PADRE
const { data: parentCategory, error: parentError } = await supabaseClient
  .from('categorias')
  .select('*')
  .eq('id', categoria.parent_id)
  .single();

/* if (parentCategory || !parentError) {
  return Astro.redirect('/404');
} */
const parentCategoria:Categoria = parentCategory || {} as Categoria;

//OBTENEMOS LAS CATEGORIAS HIJAS
const { data: categoriasHijas, error: categoriasHijasErr } = await supabaseClient
  .from('categorias')
  .select('*')
  .eq('parent_id', parentCategoria.id)


// SI NECESITAMOS UNA PAGINACION:
const url = new URL(Astro.url);
const pageParam = url.searchParams.get('page');
const page = pageParam? parseInt(pageParam) : 1;
const pageSize = 8;
const startIndex = (page - 1) * pageSize;
let totalItems = 0;

//OBTENEMOS LOS PRODUCTOS DE LA SUBCATEGORIA
let catProducts: Producto[] = [];
if (categoria) {
    const { data: productsData, error: productsError } = await supabaseClient
        .from('productos')
        .select('*')
        .eq('categoria_id', categoria.id)
        .range(startIndex, startIndex + pageSize - 1);
    if(productsData) catProducts = productsData;
}
const totalPages = totalItems ? Math.ceil(totalItems / pageSize) : 0; // Pagination

const baseCanonical = getPermalink([parentCategoria.slug,categoria.slug]);
const canonical = page > 1 
    ? `${baseCanonical}?page=${page}` 
    : baseCanonical;

// 1. Definimos la optimización
const optimizedImage = await getImage({
  src: getMediaPermalink(categoria.imagen_portada),
  width: 1200,
  height: 675,
});

// 2. Creamos la URL absoluta (Importante para OG)
const imagenCategoria = new URL(optimizedImage.src, Astro.site).toString();


const categorySchema: ProductItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name:  categoria.nombre,
  url: canonical,
  numberOfItems: catProducts.length,
  itemListElement: catProducts.map((producto, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: producto.nombre,
      description: producto.description,
      url: getPermalink([categoria.slug, producto.slug]),
      image: getMediaPermalink(producto.imagen_portada),
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: "0.00",
        availability: 'https://schema.org/InStock'
      }
    }
  }))
};
---

<Layout 
  title={categoria.nombre} 
  canonical={canonical} 
  description={categoria.description} 
  image={imagenCategoria} 
  schemas={[categorySchema]}
>
  <main class="page-container">
    <button class="mobile-menu-toggle">
      <span class="hamburger"></span>
    </button>

    <aside class="sidebar">
      <nav class="category-nav">
        <h2 class="titulos-small">Categorías</h2>
        <ul>
          {categoriasHijas?.map(subCat => (
            <li>
              <a 
                href={getPermalink(["repuestos",subCat.slug])} 
                class:list={{ active: subCat.id === categoria.id }}
              >
                {subCat.nombre}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <section class="content">
      <div class="section-header">
        <span class="section-label">Repuestos</span>
        <h1 class="titulos">{categoria.nombre}</h1>
        <p class="subtitle">
          {categoria.description || `Explora todos nuestros productos en la categoría de ${categoria.nombre}.`}
        </p>
      </div>

      {catProducts.length > 0 ? (
        <div class="products-grid">
          {catProducts.map(producto => (
            <ReplacementCard producto={producto} categorySlug={categoria.slug} />
          ))}
        </div>
      ) : (
        <p class="no-products">No hay productos disponibles en esta categoría por el momento.</p>
      )}    
    </section>
  </main>
</Layout>

<style>
  :root {
    --sidebar-width-desktop: 280px;
  }

  /* --- BASE (MOBILE-FIRST) STYLES --- */

  .page-container {
    padding: calc(var(--hheader) + 1rem) 1rem 1rem;
  }

  /* Sidebar is a slide-in menu on mobile */
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: var(--sidebar-width-desktop);
    max-height: 100vh;
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
    border-radius: 0;
    z-index: 1010;
    
    /* Visual styles */
    background: var(--darkh);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    overflow-y: auto;
  }

  .sidebar.is-open {
    transform: translateX(0);
    box-shadow: 0 0 20px rgba(0,0,0,0.2);
  }

  .category-nav h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--clr-accent);
    padding-bottom: 0.5rem;
    padding-top: calc(var(--hheader) + 1rem);
  }

  .category-nav ul { list-style: none; padding: 0; margin: 0; }
  .category-nav a {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    transition: background-color 0.2s, color 0.2s;
    font-weight: 500;
    color: var(--clr-bg); /* Text color on dark background */
  }
  .category-nav a:hover { 
    background-color: rgba(255, 255, 255, 0.1); 
  }
  .category-nav a.active {
    background-color: var(--clr-accent);
    color: var(--clr-bg);
    font-weight: 700;
  }

  /* Content takes full width on mobile */
  .content {
    flex: 1;
    min-width: 0;
    padding: 1rem;
  }

  .section-header { text-align: center; margin-bottom: 4rem; }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .no-products {
      text-align: center;
      font-size: 1.2rem;
      color: var(--clr-text-secondary);
      margin-top: 4rem;
  }

  /* Mobile Menu Toggle Button */
  .mobile-menu-toggle {
    display: flex;
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1020;
    background-color: var(--light);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border:none;
  }
  
  .hamburger {
    width: 24px;
    height: 3px;
    background: var(--dark);
    position: relative;
    transition: transform 0.3s, background-color 0.3s;
  }
  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--dark);
    transition: transform 0.3s, top 0.3s;
  }
  .hamburger::before { top: -8px; }
  .hamburger::after { top: 8px; }
  
  .is-open .hamburger { background-color: transparent; }
  .is-open .hamburger::before { top: 0; transform: rotate(45deg); }
  .is-open .hamburger::after { top: 0; transform: rotate(-45deg); }

  /* --- DESKTOP STYLES (min-width) --- */
  @media (min-width: 769px) {
    .page-container {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      padding: calc(var(--hheader) + 2rem) 1rem 2rem;
    }

    .sidebar {
      position: sticky;
      top: calc(var(--hheader) + 2rem);
      transform: translateX(0);
      z-index: 1; /* Reset z-index for sticky positioning */
      height: auto;
      max-height: calc(100vh - var(--hheader) - 4rem);
      width: var(--sidebar-width-desktop);
      border-radius: var(--radius-lg);
    }
    
    .category-nav h2 {
      padding-top: 0;
    }

    .content {
      padding: 2rem;
    }

    .mobile-menu-toggle {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.querySelector('.mobile-menu-toggle');
    const sidebar = document.querySelector('.sidebar');

    if (toggleButton && sidebar) {
      toggleButton.addEventListener('click', (e) => {
        e.stopPropagation();
        sidebar.classList.toggle('is-open');
        toggleButton.classList.toggle('is-open');
      });
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (sidebar?.classList.contains('is-open') && !sidebar.contains(target) && !toggleButton?.contains(target)) {
        sidebar.classList.remove('is-open');
        toggleButton?.classList.remove('is-open');
      }
    });
  });
</script>