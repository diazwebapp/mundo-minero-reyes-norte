---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseClient } from "../../../lib/supabase";
import Pagination from "../../../components/Pagination.astro";

const url = new URL(Astro.url);
const page = parseInt(url.searchParams.get("page") || "1");
const pageSize = 12; // Adjusted for a grid layout
const startIndex = (page - 1) * pageSize;
let totalItems = 0;

const { count: mediaCount, error: countError } = await supabaseClient
  .from('media_files')
  .select('*', { count: 'exact', head: true });

if (mediaCount !== null) {
  totalItems = mediaCount;
}

const { data: mediaFiles, error } = await supabaseClient
  .from('media_files')
  .select('*')
  .order('created_at', { ascending: false })
  .range(startIndex, startIndex + pageSize - 1);
  
const totalPages = totalItems ? Math.ceil(totalItems / pageSize) : 0;

if (error) {
  console.error("Error fetching media files:", error.message);
}
---
<AdminLayout title="Administrador de Medios">
  
  <div class="upload-section">
    <h3>Subir Nuevos Archivos</h3>
    <form id="upload-media-form" enctype="multipart/form-data">
      <div class="form-group">
        <label for="media-upload">Seleccionar archivos</label>
        <input type="file" id="media-upload" name="files" multiple required>
      </div>
      <button type="submit" class="btn">Subir</button>
    </form>
  </div>

  <div class="divider"></div>

  {error && <p class="error-message">Error al cargar los archivos: {error.message}</p>}

  <div class="media-grid">
    {mediaFiles && mediaFiles.map(file => (
      <div class="media-card">
        <div class="preview">
          {file.file_type.startsWith('image/') ? (
            <img src={file.public_url} alt={file.alt_text || file.file_path} loading="lazy" />
          ) : (
            <div class="file-placeholder">
              <span>.{file.file_type.split('/')[1] || 'file'}</span>
            </div>
          )}
        </div>
        <div class="info">
          <p class="file-path" title={file.file_path}>{file.file_path}</p>
          <div class="actions">
            <form method="POST" action={`/api/admin/media/${file.id}`} onsubmit="return confirm('¿Estás seguro de que quieres eliminar este archivo permanentemente?');">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
            </form>
          </div>
        </div>
      </div>
    ))}
  </div>
  <Pagination currentPage={page} totalPages={totalPages} />
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const uploadForm = document.getElementById('upload-media-form');
    if (uploadForm) {
      uploadForm.addEventListener('submit', async (event) => {
        event.preventDefault(); // Prevent default form submission

        const formData = new FormData(uploadForm);
        const submitButton = uploadForm.querySelector('button[type="submit"]');
        submitButton.disabled = true;
        submitButton.textContent = 'Subiendo...';

        try {
          const response = await fetch('/api/admin/media/upload', {
            method: 'POST',
            body: formData,
          });

          if (response.ok) {
            alert('Archivos subidos exitosamente!');
            window.location.reload(); // Reload the page to show new files
          } else {
            const errorData = await response.json();
            alert(`Error al subir archivos: ${errorData.message || response.statusText}`);
          }
        } catch (error) {
          console.error('Error durante la subida:', error);
          alert('Ocurrió un error inesperado al subir los archivos.');
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = 'Subir';
        }
      });
    }
  });
</script>

<style>
  .upload-section {
    background: var(--clr-bg-alt);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
    border: 1px solid var(--clr-border);
  }
  .upload-section h3 {
    margin-top: 0;
  }
  .upload-section form {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
  }
  .upload-section .form-group {
    flex-grow: 1;
  }
  .upload-section label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--clr-text-alt);
    display: block;
    margin-bottom: 0.5rem;
  }
  .upload-section input[type="file"] {
    width: 100%;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg);
    color: var(--clr-text);
  }
  .divider {
    height: 1px;
    background: var(--clr-border);
    margin: 2rem 0;
  }
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .media-card {
    background: var(--clr-bg-alt);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--clr-border);
    display: flex;
    flex-direction: column;
  }
  .preview {
    aspect-ratio: 16 / 10;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .file-placeholder {
    color: var(--clr-text-alt);
    font-size: 2rem;
    font-weight: bold;
  }
  .info {
    padding: 1rem;
  }
  .file-path {
    font-size: 0.8rem;
    color: var(--clr-text-alt);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0 0 1rem 0;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
  }
  .btn-sm {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
  }
</style>
