---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabase } from "../../../lib/supabase";
import Pagination from "../../../components/Pagination.astro";

const url = new URL(Astro.url);
const page = parseInt(url.searchParams.get("page") || "1");
const pageSize = 10;
const startIndex = (page - 1) * pageSize;
let totalItems = 0;

const { count: categoriesCount, error: countError } = await supabase
  .from('categorias')
  .select('*', { count: 'exact', head: true });

if (categoriesCount !== null) {
  totalItems = categoriesCount;
}

const { data: categorias, error } = await supabase
  .from('categorias')
  .select('*')
  .order('id', { ascending: true })
  .range(startIndex, startIndex + pageSize - 1);

const totalPages = totalItems ? Math.ceil(totalItems / pageSize) : 0;

if (error) {
  console.error("Error fetching categories:", error.message);
}
---

<AdminLayout title="Categorías">
  <div class="action-bar">
    <a href="/admin/categorias/nuevo" class="btn">Crear Nueva Categoría</a>
  </div>

  {error && <p class="error-message">Error al cargar categorías: {error.message}</p>}

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Slug</th>
          <th>Parent ID</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {categorias && categorias.map(cat => (
          <tr>
            <td>{cat.id}</td>
            <td>{cat.nombre}</td>
            <td>{cat.slug}</td>
            <td>{cat.parent_id ?? 'N/A'}</td>
            <td class="actions">
              <a href={`/admin/categorias/${cat.id}`} class="btn btn-secondary">Editar</a>
              <form method="POST" action={`/api/admin/categorias/${cat.id}`} onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta categoría?');">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-danger">Eliminar</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <Pagination currentPage={page} totalPages={totalPages} />
</AdminLayout>

<style>
  .error-message {
    background-color: var(--clr-accent);
    color: white;
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
  }
  .action-bar {
    margin-bottom: 2rem;
    text-align: right;
  }
  .table-wrapper {
    overflow-x: auto;
    background: var(--clr-bg-alt);
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th, td {
    padding: 1rem 1.5rem;
    text-align: left;
    border-bottom: 1px solid var(--clr-border);
  }
  thead {
    background: #111827;
  }
  th {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--clr-text-alt);
  }
  tbody tr:last-child td {
    border-bottom: none;
  }
  tbody tr:hover {
    background-color: #1f2937;
  }
  .actions {
    display: flex;
    gap: 0.5rem;
  }
  .actions .btn {
    padding: 0.4rem 0.8rem;
    font-size: 0.875rem;
  }
</style>
