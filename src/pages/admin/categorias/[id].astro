---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabase } from "../../../lib/supabase";
import ImagePicker from "../../../components/admin/ImagePicker.astro";
import type { Categoria } from "../../../local-data/database.types";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect('/admin/categorias');
}

// Fetch the specific category to edit
const { data: categoria, error: fetchError } = await supabase
    .from('categorias')
    .select('*')
    .eq('id', id)
    .single();

// If the category is not found or there was a database error, redirect to the list
if (fetchError || !categoria) {
    console.error("Error fetching category or category not found. ID:", id, "Error:", fetchError?.message);
    return Astro.redirect('/admin/categorias');
}

// Fetch all categories for the parent dropdown
const { data: allCategorias, error: dropdownError } = await supabase.from('categorias').select('id, nombre');

---
<AdminLayout title={`Editar Categoría: ${categoria.nombre}`}>
    
    {dropdownError && <p class="error">Error loading parent categories: {dropdownError.message}</p>}

    <form method="POST" action={`/api/admin/categorias/${id}`}>
        <input type="hidden" name="_method" value="PUT" />

        <div class="form-group">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" value={categoria.nombre} required />
        </div>

        <div class="form-group">
            <label for="description">Descripción</label>
            <textarea id="description" name="description" rows="4">{categoria.description}</textarea>
        </div>

        <div class="form-group">
            <label for="slug">Slug</label>
            <input type="text" id="slug" name="slug" value={categoria.slug} required />
        </div>

        <div class="form-group">
            <label for="parent_id">Categoría Padre</label>
            <select id="parent_id" name="parent_id">
                <option value="">-- Ninguna --</option>
                {allCategorias && allCategorias.map(cat => (
                    // Exclude the current category from being its own parent
                    cat.id !== categoria.id && <option value={cat.id} selected={cat.id === categoria.parent_id}>{cat.nombre}</option>
                ))}
            </select>
        </div>

        <div class="form-group">
            <label>Imagen de Portada</label>
            <ImagePicker name="imagen_portada" currentImageUrl={categoria.imagen_portada} />
        </div>

        <div class="form-group form-group-checkbox">
            <input type="checkbox" id="show" name="show" checked={categoria.show} />
            <label for="show">Mostrar esta categoría</label>
        </div>

        <button type="submit" class="btn">Actualizar Categoría</button>
    </form>
</AdminLayout>

<style>
    .error {
        color: white;
        background-color: var(--clr-accent);
        padding: 1rem;
        border-radius: var(--radius-md);
        margin-bottom: 1.5rem;
    }
    form { display: grid; gap: 1.5rem; max-width: 800px; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    label { font-weight: 700; font-size: 0.9rem; color: var(--clr-text-alt); }
    input[type="text"], textarea, select {
        width: 100%;
        padding: 0.8rem 1rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--clr-border);
        background: var(--clr-bg-alt);
        color: var(--clr-text);
        font-size: 1rem;
        transition: border-color 0.2s;
    }
    input:focus, textarea:focus, select:focus {
        outline: none;
        border-color: var(--clr-accent);
    }
    .form-group-checkbox { flex-direction: row; align-items: center; }
    .form-group-checkbox input { width: auto; margin-right: 0.5rem; }
</style>
