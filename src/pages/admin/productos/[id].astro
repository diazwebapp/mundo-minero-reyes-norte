---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseClient } from "../../../lib/supabase";
import ImagePicker from "../../../components/admin/ImagePicker.astro";
import MultiImagePicker from "../../../components/admin/MultiImagePicker.astro";
import CaracteristicasForm from "../../../components/admin/CaracteristicasForm.astro";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect('/admin/productos');
}

const { data: producto, error: fetchError } = await supabaseClient
    .from('productos')
    .select('*')
    .eq('id', id)
    .single();

if (fetchError || !producto) {
    console.error("Error fetching product or product not found. ID:", id, "Error:", fetchError?.message);
    return Astro.redirect('/admin/productos');
}

const { data: allCategorias, error: dropdownError } = await supabaseClient.from('categorias').select('id, nombre');

---
<AdminLayout title={`Editar Producto: ${producto.nombre}`}>
    
    {dropdownError && <p class="error">Error loading categories: {dropdownError.message}</p>}

    <form method="POST" action={`/api/admin/productos/${id}`}>
        <input type="hidden" name="_method" value="PUT" />

        <div class="form-group">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" value={producto.nombre} required />
        </div>

        <div class="form-group">
            <label for="description">Descripción</label>
            <textarea id="description" name="description" rows="4">{producto.description}</textarea>
        </div>

        <div class="form-group">
            <label for="slug">Slug</label>
            <input type="text" id="slug" name="slug" value={producto.slug} required />
        </div>

        <div class="form-group">
            <label for="categoria_id">Categoría</label>
            <select id="categoria_id" name="categoria_id" required>
                <option value="">-- Selecciona una categoría --</option>
                {allCategorias && allCategorias.map(cat => (
                    <option value={cat.id} selected={cat.id === producto.categoria_id}>{cat.nombre}</option>
                ))}
            </select>
        </div>

        <div class="form-group">
            <label>Imagen de Portada</label>
            <ImagePicker name="imagen_portada" currentImageUrl={producto.imagen_portada} />
        </div>

        <div class="form-group">
            <label>Imágenes</label>
            <MultiImagePicker name="imagenes" currentImages={producto.imagenes} />
        </div>
        <div class="form-group">
            <label>Características</label>
            <CaracteristicasForm currentCaracteristicas={producto.caracteristicas} />
        </div>
        <button type="submit" class="btn">Actualizar Producto</button>
    </form>
</AdminLayout>

<style>
    .error {
        color: white;
        background-color: var(--clr-accent);
        padding: 1rem;
        border-radius: var(--radius-md);
        margin-bottom: 1.5rem;
    }
    form { display: grid; gap: 1.5rem; max-width: 800px; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    label { font-weight: 700; font-size: 0.9rem; color: var(--clr-text-alt); }
    input[type="text"], textarea, select {
        width: 100%;
        padding: 0.8rem 1rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--clr-border);
        background: var(--clr-bg-alt);
        color: var(--clr-text);
        font-size: 1rem;
        transition: border-color 0.2s;
    }
    input:focus, textarea:focus, select:focus {
        outline: none;
        border-color: var(--clr-accent);
    }
    small {
        font-size: 0.8rem;
        color: var(--clr-text-alt);
    }
</style>
