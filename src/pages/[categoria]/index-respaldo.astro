---
import { categorias, productos } from '../../local-data/database';
import { BASE_URL } from '../../utils/config';

import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';

// Obtener parámetro dinámicamente (funciona con SSR)
// quitamos cualquier barra final que el router pudiera dar
let { categoria: categoriaSlug } = Astro.params;

console.log('Categoría solicitada:', categoriaSlug);
// Buscar categoría por slug (sin barras)
const categoria = categorias.find(cat => cat.slug === categoriaSlug);
if (!categoria) {
  return Astro.redirect('/404');
}

// Obtener productos de esa categoría
const productosDeCategoria = productos.filter(p => p.categoria_id === categoria.id);



const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: categoria.nombre,
  url: absoluteUrl,
  numberOfItems: productosDeCategoria.length,
  itemListElement: productosDeCategoria.map((producto, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    "item": {
      '@type': 'Product',
      name: producto.nombre,
      description: producto.description,
      url: `${BASE_URL}${getProductUrl(categoria.slug, producto.slug)}`,
      image: `${BASE_URL}${producto.imagen_portada}`,
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: "0.00",
        availability: 'https://schema.org/InStock'
      }
    }
  }))
};
---

<Layout>
  <section class="container">
    
      <div class="section-header">
        <span class="section-label">Categoría</span>
        <h1 class="titulos" >{categoria.nombre}</h1>
        <p class="subtitle">
          Explora todos nuestros productos en la categoría de {categoria.nombre}.
        </p>
      </div>

      {productosDeCategoria.length > 0 ? (
        <div class="products-grid">
          {productosDeCategoria.map(producto => (
            <ProductCard producto={producto} categorySlug={categoria.slug} />
          ))}
        </div>
      ) : (
        <p class="no-products">No hay productos disponibles en esta categoría por el momento.</p>
      )}
    
  </section>
</Layout>

<style>
  .container{
    padding:calc(var(--hheader) + 1rem) 1rem;
  }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>