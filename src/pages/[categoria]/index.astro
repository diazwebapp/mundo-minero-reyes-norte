---
import { categorias, productos } from '../../local-data/database';
import Layout from '../../layouts/Layout.astro';
import { getMediaPermalink, getPermalink } from '../../utils/config';
import {get_products,get_categories} from '../../utils/consultas'
import ProductCard from '../../components/ProductCard.astro';
import type { Categoria, Producto } from '../../local-data/database.types';

const { categoria: catSlug } = Astro.params;
// 2. Limpiamos y GUARDAMOS el resultado (quitamos la barra inicial)
catSlug?.replace(/^\//, '') || '';

const categoria = categorias.find(cat => cat.slug === catSlug);
/* SI NECESITAMOS UNA PAGINACION:
const url = new URL(Astro.url);
const page = parseInt(url.searchParams.get('page') || '1');
 */
if (!categoria) {
  return Astro.redirect('/404');
}

const permalink = getPermalink([categoria.slug]);
const imagenCategoria = getMediaPermalink(categoria.imagen_portada)
let catProducts:Producto[] | Categoria[] =[];
if(categoria.show === true ){
  console.log(categoria.parent_id)
  catProducts = get_products(productos,1,8,categoria.id);
}
if(categoria.show === false){
  console.log(categoria.parent_id)
  catProducts = get_categories(categorias,1,8,categoria.id);
}

const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: categoria.nombre,
  url: permalink,
  numberOfItems: catProducts.length,
  itemListElement: catProducts.map((producto, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    "item": {
      '@type': 'Product',
      name: producto.nombre,
      description: producto.description,
      url: getPermalink([categoria.slug,producto.slug]),
      image:getMediaPermalink(producto.imagen_portada),
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: "0.00",
        availability: 'https://schema.org/InStock'
      }
    }
  }))
};
---

<Layout title={categoria.nombre} canonical={permalink} description={categoria.description} image={imagenCategoria} schemas={[categorySchema]} >
  <section class="container">
    <div class="section-header">
        <span class="section-label">Categoría</span>
        <h1 class="titulos" >{categoria.nombre}</h1>
        <p class="subtitle">
          Explora todos nuestros productos en la categoría de {categoria.nombre}.
        </p>
      </div>

      {catProducts.length > 0 ? (
        <div class="products-grid">
          {catProducts.map(producto => (
            <ProductCard producto={producto} categorySlug={categoria.slug} />
          ))}
        </div>
      ) : (
        <p class="no-products">No hay productos disponibles en esta categoría por el momento.</p>
      )}    
  </section>
</Layout>

<style>
  .container{
    padding:calc(var(--hheader) + 1rem) 1rem;
  }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>