---
import { supabaseClient } from '../../lib/supabase';
import Layout from '../../layouts/Layout.astro';
import { getMediaPermalink, getPermalink, BASE_URL } from '../../utils/config';
import ProductCard from '../../components/ProductCard.astro';
import type { Categoria, Producto } from '../../local-data/database.types';
import type { Article,  OrganizationSchema, TSGCategorySchema } from '../../local-data/schemas';
import { fichaTecnica } from '../../local-data/ficha-tecnica';
import type { ProductItemListSchema } from '../../local-data/schemas';
import Pagination from '../../components/Pagination.astro';
import { getImage } from 'astro:assets';

const { categoria: catSlug } = Astro.params;
const currentCatSlug = catSlug?.replace(/^\//, '') || '';

const { data: categoria, error: catError } = await supabaseClient.from('categorias').select('*').eq('slug', currentCatSlug).single();

// SI NECESITAMOS UNA PAGINACION:
const url = new URL(Astro.url);
const page = parseInt(url.searchParams.get('page') || '1');
const pageSize = 8;
const startIndex = (page - 1) * pageSize;
let totalItems = 0;

if (catError || !categoria) {
  return Astro.redirect('/404');
}

const baseCanonical = getPermalink([categoria.slug]);
const canonical = page > 1 
    ? `${baseCanonical}?page=${page}` 
    : baseCanonical;

// 1. Definimos la optimización
const optimizedImage = await getImage({
  src: getMediaPermalink(categoria.imagen_portada),
  width: 1200,
  height: 675,
});

// 2. Creamos la URL absoluta (Importante para OG)
const ogImageUrl = new URL(optimizedImage.src, Astro.site).toString();

let catProducts:Producto[] | Categoria[] =[];

if(categoria.show === true ){
    const { count: productsCountResponse, error: countError } = await supabaseClient
        .from('productos')
        .select('*', { count: 'exact', head: true })
        .eq('categoria_id', categoria.id);

    if (productsCountResponse !== null) totalItems = productsCountResponse;

    const { data: products, error: productsError } = await supabaseClient
        .from('productos')
        .select('*')
        .eq('categoria_id', categoria.id)
        .range(startIndex, startIndex + pageSize - 1); // Pagination

    if (products) catProducts = products;
} else { // categoria.show === false
    const { count: categoriesCountResponse, error: countError } = await supabaseClient
        .from('categorias')
        .select('*', { count: 'exact', head: true })
        .eq('parent_id', categoria.id);

    if (categoriesCountResponse !== null) totalItems = categoriesCountResponse;

    const { data: categories, error: categoriesError } = await supabaseClient
        .from('categorias')
        .select('*')
        .eq('parent_id', categoria.id)
        .range(startIndex, startIndex + pageSize - 1); // Pagination
    
    if (categories) catProducts = categories;
}

const totalPages = totalItems ? Math.ceil(totalItems / pageSize) : 0; // Pagination

const organization: OrganizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": fichaTecnica.informacion_general.nombre_corto,
    "url": BASE_URL,
    "logo": `${BASE_URL}/logo-claro.jpeg`,
    "sameAs": [
        "https://www.facebook.com/mmlosreyesdelnorte",
        "https://www.instagram.com/mmreyesdelnorte",
    ]
}
const categorySchema:ProductItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: categoria.nombre,
  url: canonical,
  numberOfItems: catProducts.length,
  itemListElement: catProducts.map((producto, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    "item": {
      '@type': 'Product',
      name: producto.nombre,
      description: producto.description,
      url: getPermalink([categoria.slug,producto.slug]),
      image:getMediaPermalink(producto.imagen_portada),
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: "0.00",
        availability: 'https://schema.org/InStock'
      }
    }
  }))
};
const schemaArticle: Article = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": categoria.nombre ,
    "image": [ogImageUrl],
    "datePublished": "2024-01-01",
    "dateModified": "2024-01-01",
    "author": {
       "@type": "Person",
        "name": "MM Reyes del norte",
        "url": canonical
    },
    "publisher":organization,
    "description": "Descubre todo lo que necesitas saber sobre grupos electrógenos, desde tipos y comparativas hasta consejos de compra. Encuentra el generador eléctrico perfecto para tus necesidades."
}

const totalPageSchema:TSGCategorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": categoria.nombre,
  "url": canonical,
  "description": schemaArticle.description,

  "publisher": organization,

  "mainEntity": categorySchema,

  "hasPart": [
    schemaArticle
  ]
};

---

<Layout title={categoria.nombre} canonical={canonical} description={categoria.description} image={ogImageUrl} schemas={[totalPageSchema]} >
  <section class="container">
    <div class="section-header">
        <span class="section-label">Categoría</span>
        <h1 class="titulos" >{categoria.nombre}</h1>
        <p class="subtitle">
          Explora todos nuestros productos en la categoría de {categoria.nombre}.
        </p>
      </div>

      {catProducts.length > 0 ? (
        <>
          <div class="products-grid">
            {catProducts.map(producto => (
              <ProductCard producto={producto} categorySlug={categoria.slug} />
            ))}
          </div>
          
        </>
      ) : (
        <p class="no-products">No hay productos disponibles en esta categoría por el momento.</p>
      )}  
      
      <Pagination totalPages={totalPages} currentPage={page} />
  </section>
</Layout>

<style>
  .container{
    padding:calc(var(--hheader) + 1rem) 1rem;
  }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>