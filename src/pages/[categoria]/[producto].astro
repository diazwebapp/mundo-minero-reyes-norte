---
import { productos, categorias } from '../../local-data/database';
import type { Producto, Categoria } from '../../local-data/database.types';
import type { ProductSchema } from '../../local-data/schemas';
import Layout from '../../layouts/Layout.astro';
import { BASE_URL } from '../../components/slugify';
import { Image } from 'astro:assets';
import { fichaTecnica } from '../../local-data/ficha-tecnica';

// Obtener parámetros dinámicamente (funciona con SSR) y normalizarlos
let { categoria: categoriaSlug, producto: productoSlug } = Astro.params;
categoriaSlug = categoriaSlug?.replace(/\/+$/,'');
productoSlug = productoSlug?.replace(/\/+$/,'');


const producto = productos.find(p => p.slug === productoSlug);
if (!producto) {
  return Astro.redirect('/404');
}

const productSchema: ProductSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${producto.nombre}`,
  "description": producto.description,
  "url": `${BASE_URL}${categoriaSlug}/${producto.slug}/`,
  "image": [producto.imagen_portada],
  "brand": {
    "@type": "Brand",
    "name": 'Mundo Minero Los Reyes Norte'
  },
  offers: {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": 0.00,
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
};

// Función para renderizar características técnicas dinámicamente
interface Spec {
  label: string;
  value: string | undefined;
}

const specs: Spec[] = [
  { label: "Modelo/Capacidad", value: producto.modelo_o_capacidad },
  { label: "Tipo de Motor", value: producto.motor?.tipo },
  { label: "Potencia", value: producto.motor?.potencia || producto.motor_potencia },
  { label: "Refrigeración", value: producto.motor?.refrigeracion },
  { label: "Modelo Motor", value: producto.motor?.modelo },
  { label: "Marca Motor", value: producto.motor?.marca },
  { label: "RPM", value: producto.motor?.rpm },
  { label: "Dimensiones Globales", value: producto.dimensiones_globales },
  { label: "Sistema de Transmisión", value: producto.sistema_transmision },
  { label: "Caja de Cambios", value: producto.caja_cambios },
  { label: "Peso", value: producto.peso },
  { label: "Baterías", value: producto.baterias },
  { label: "Autonomía", value: producto.autonomia },
  { label: "Voltaje", value: producto.voltaje },
  { label: "Tensión", value: producto.tension },
  { label: "Fases", value: producto.fases },
  { label: "Altura Máx. Pala", value: producto.altura_max_pala },
  { label: "Capacidad de Carga", value: producto.capacidad_carga },
  { label: "Volumen Cucharón", value: producto.volumen_cucharon },
  { label: "Eficiencia", value: producto.eficiencia },
  { label: "Consumo de Aire", value: producto.consumo_aire },
  { label: "Profundidad Máx. Taladro", value: producto.profundidad_max_taladro },
  { label: "Longitud Cable", value: producto.longitud_cable },
  { label: "Flujo de Aire", value: producto.flujo_aire }
];

// Filtrar solo las características que existen
const specsFiltered = specs.filter(spec => spec.value);
---

<Layout title={producto.nombre} description={producto.description} canonical={`${BASE_URL}${categoriaSlug}/${producto.slug}/`} schemas={[productSchema]}>
  <section class="product-page">
    <div class="container">
      
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb">
        <a href={`${BASE_URL}`}>Inicio</a>
        <span>/</span>
        <a href={`${BASE_URL}${categoriaSlug}/`}>{categorias.find(c => c.slug === categoriaSlug)?.nombre}</a>
        <span>/</span>
        <span>{producto.nombre}</span>
      </nav>

      <!-- Main Product Section -->
      <div class="product-hero">
        <!-- Product Image -->
        <div class="product-image-wrapper">
          <Image 
            src={producto.imagen_portada} 
            alt={producto.nombre} 
            title={producto.nombre}
            width={400}
            height={400}
            class="product-image"
          />
        </div>

        <!-- Product Info Sidebar -->
        <div class="product-sidebar">
          <h1 class="product-title">{producto.nombre}</h1>
          
          <p class="product-description">{producto.description}</p>
          
          <!-- Quick Specs -->
          {producto.modelo_o_capacidad && (
            <div class="quick-spec">
              <span class="spec-label">Modelo</span>
              <span class="spec-value">{producto.modelo_o_capacidad}</span>
            </div>
          )}
          
          {producto.motor?.potencia && (
            <div class="quick-spec">
              <span class="spec-label">Potencia</span>
              <span class="spec-value">{producto.motor.potencia}</span>
            </div>
          )}
          
          {producto.motor?.tipo && (
            <div class="quick-spec">
              <span class="spec-label">Motor</span>
              <span class="spec-value">{producto.motor.tipo}</span>
            </div>
          )}

          <!-- CTA Button -->
          <div class="cta-section">
            <h3>¿Interesado en este producto?</h3>
            <p class="cta-text">Contáctanos para obtener más información, cotizaciones y disponibilidad.</p>
            <a href={`mailto:${fichaTecnica.datos_contacto.correo_electronico}`} class="btn btn-primary">
              Solicitar Información
            </a>
            <a href={`https://api.whatsapp.com/send?phone=${fichaTecnica.datos_contacto.whatsapp?.replace(/\D/g, '') || '51920310887'}&text=Hola,%20estoy%20interesado%20en%20el%20producto:%20${producto.nombre}`} class="btn btn-secondary">
              Contactar por WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Technical Specifications Table -->
      {specsFiltered.length > 0 && (
        <div class="specs-section">
          <h2>Características Técnicas</h2>
          <div class="specs-table-wrapper">
            <table class="specs-table">
              <thead>
                <tr>
                  <th>Característica</th>
                  <th>Valor</th>
                </tr>
              </thead>
              <tbody>
                {specsFiltered.map(spec => (
                  <tr>
                    <td class="spec-name">{spec.label}</td>
                    <td class="spec-value">{spec.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Call To Action Section -->
      <section class="final-cta">
        <div class="cta-content">
          <h2>Consigue tu equipo hoy</h2>
          <p>Mundo Minero Los Reyes del Norte ofrece soluciones confiables para tus necesidades mineras.</p>
          <div class="cta-buttons">
            <a href={`tel:${fichaTecnica.datos_contacto.telefono_ventas}`} class="btn btn-primary btn-large">Llamar Ahora</a>
            <a href={`mailto:${fichaTecnica.datos_contacto.correo_electronico}?subject=Consulta%20producto:%20${producto.nombre}`} class="btn btn-outline btn-large">Enviar Email</a>
          </div>
        </div>
      </section>

    </div>
  </section>
</Layout>

<style>
  .product-page {
    padding-top: calc(var(--hheader) + 2rem);
    padding-bottom: 4rem;
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .breadcrumb a {
    color: #e74c3c;
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .breadcrumb span {
    color: rgba(255, 255, 255, 0.5);
  }

  /* Product Hero Section */
  .product-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
    align-items: start;
  }

  .product-image-wrapper {
    background: var(--darkh);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    border: 1px solid rgba(231, 76, 60, 0.3);
  }

  .product-image {
    max-width: 400px;
    height: auto;
    border-radius: 12px;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.4));
    object-fit: contain;
  }

  .product-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--darkh);
    backdrop-filter: blur(10px);
    padding: 2rem;
  }

  .product-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    margin: 0;
  }

  .product-description {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  /* Quick Specs */
  .quick-spec {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--darkh);
    border-left: 3px solid #e74c3c;
    border-radius: 8px;
  }

  .spec-label {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
  }

  .quick-spec .spec-value {
    font-weight: 700;
    color: #e74c3c;
    font-size: 1rem;
  }

  /* CTA Section */
  .cta-section {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.1) 0%, rgba(231, 76, 60, 0.05) 100%);
    border: 1px solid rgba(231, 76, 60, 0.3);
    padding: 2rem;
    border-radius: 12px;
    margin-top: 1rem;
  }

  .cta-section h3 {
    font-size: 1.3rem;
    margin: 0 0 0.5rem 0;
    color: #fff;
  }

  .cta-text {
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 1.5rem 0;
    font-size: 0.95rem;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    text-align: center;
    cursor: pointer;
    border: none;
    font-size: 1rem;
  }

  .btn-primary {
    background-color: #e74c3c;
    color: white;
    width: 100%;
    margin-bottom: 0.75rem;
  }

  .btn-primary:hover {
    background-color: #c0392b;
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(231, 76, 60, 0.3);
  }

  .btn-secondary {
    background-color: transparent;
    color: #e74c3c;
    border: 2px solid #e74c3c;
    width: 100%;
  }

  .btn-secondary:hover {
    background-color: #e74c3c;
    color: white;
    transform: translateY(-2px);
  }

  .btn-outline {
    background-color: transparent;
    color: #e74c3c;
    border: 2px solid #e74c3c;
  }

  .btn-outline:hover {
    background-color: #e74c3c;
    color: white;
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.05rem;
  }

  /* Technical Specifications */
  .specs-section {
    margin: 4rem 0;
    background: var(--darkh);
    backdrop-filter: blur(10px);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid rgba(231, 76, 60, 0.2);
  }

  .specs-section h2 {
    font-size: 1.8rem;
    margin: 0 0 1.5rem 0;
    color: #fff;
    text-align: center;
  }

  .specs-table-wrapper {
    overflow-x: auto;
  }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
  }

  .specs-table thead {
    background: rgba(231, 76, 60, 0.15);
  }

  .specs-table th {
    padding: 1rem;
    text-align: left;
    font-weight: 700;
    color: #e74c3c;
    border-bottom: 2px solid rgba(231, 76, 60, 0.3);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .specs-table td {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
  }

  .specs-table tbody tr:hover {
    background-color: rgba(231, 76, 60, 0.05);
  }

  .specs-table tbody tr:last-child td {
    border-bottom: none;
  }

  .spec-name {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    width: 40%;
  }

  .specs-table .spec-value {
    color: #e74c3c;
    font-weight: 600;
  }

  /* Final CTA */
  .final-cta {
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    padding: 3rem;
    border-radius: 12px;
    text-align: center;
    margin-top: 4rem;
  }

  .cta-content h2 {
    font-size: 2rem;
    margin: 0 0 0.5rem 0;
    color: white;
  }

  .cta-content p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.95);
    margin: 0 0 2rem 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .final-cta .btn-primary {
    background-color: white;
    color: #e74c3c;
    width: auto;
  }

  .final-cta .btn-primary:hover {
    background-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
  }

  .final-cta .btn-outline {
    background-color: transparent;
    color: white;
    border-color: white;
  }

  .final-cta .btn-outline:hover {
    background-color: white;
    color: #e74c3c;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .product-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product-title {
      font-size: 1.8rem;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn-large {
      width: 100%;
    }

    .specs-table th,
    .specs-table td {
      padding: 0.75rem 0.5rem;
    }

    .spec-name {
      width: 50%;
    }

    .breadcrumb {
      font-size: 0.8rem;
      margin-bottom: 1.5rem;
    }

    .final-cta {
      padding: 2rem 1.5rem;
    }

    .cta-content h2 {
      font-size: 1.5rem;
    }

    .cta-content p {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 1rem;
    }

    .product-title {
      font-size: 1.5rem;
    }

    .product-description {
      font-size: 1rem;
    }

    .product-image-wrapper {
      min-height: 250px;
      padding: 1rem;
    }

    .specs-section {
      padding: 1rem;
    }

    .cta-section {
      padding: 1.5rem;
    }

    .quick-spec {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
