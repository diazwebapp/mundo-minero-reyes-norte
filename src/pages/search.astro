---
import LayoutSearch from '../layouts/LayoutSearch.astro';
---

<LayoutSearch>
  <main class="serp-container">
    <section class="container">
      <div class="serp-meta">
      <h2 id="results-title">Buscador de Maquinaria</h2>
      <p id="results-count">Ingresa un término para buscar</p>
    </div>
    </section>
    <section class="container">
      <div id="products-grid" class="categories-grid"></div>

    <p id="no-products" class="no-products hidden">
      No hay productos disponibles para esta búsqueda.
    </p>
    </section>
  </main>
</LayoutSearch>

<style is:inline>
  .serp-container{
    padding:var(--hheader) 1rem;
  }
  .serp-meta{
    width:100%;
    padding:2rem 1rem;
    display:flex;
    justify-content: space-between;
    gap:2rem;
  }
.product-card {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 8px var(--plata);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(10px);
    position: relative;
  }
.product-image {
		position: relative;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0 auto;
	}

  .product-image img{
    aspect-ratio: 16/9;
  }
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 1px 2px var(--dark);
  }

  .product-info {
    padding: .8rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

/* overlay anchor covering card */
.stretched-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* no visible content – aria-label above handles accessibility */
}

.btn {
    position: relative;
    z-index: 2;
    pointer-events: none; /* allow overlay link to receive clicks */
}
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .hidden { display: none !important; }
  /* Asegúrate de que .products-grid coincida con tus estilos de la imagen */
  .categories-grid {
		display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
	}
</style>

<script>

  // Definimos la interfaz para que TypeScript no se queje
  interface Producto {
    nombre: string;
    description: string;
    caracteristicas: { [key: string]: string }; // Updated to flat key-value
    imagen_portada: string;
    slug: string;
  }

  const searchInput = document.getElementById('main-search') as HTMLInputElement;
  const grid = document.getElementById('products-grid') as HTMLDivElement;
  const countText = document.getElementById('results-count');
  const noProductsMsg = document.getElementById('no-products');

  let debounceTimer: number;

  async function search(text: string) {
    try {
      const resp = await fetch(`/api/productos?text=${encodeURIComponent(text)}`);
      const productos: Producto[] = await resp.json();

      // Limpiamos el grid
      grid.innerHTML = '';

      if (productos.length > 0) {
        noProductsMsg?.classList.add('hidden');
        grid.classList.add('products-grid'); // Mantiene tu clase de la imagen

        // Renderizamos cada producto
        productos.forEach(prod => {
          const cardHtml = `
            <article class="product-card">
              <a
                href="${prod.slug}"
                class="stretched-link"
                aria-label="Ver detalles de ${prod.nombre}"
              >
                <span class="sr-only">Ver detalles de ${prod.nombre}</span>
              </a>
            <div class="product-image">
              <img
                src=${prod.imagen_portada}
                alt="${prod.nombre}"
                title="${prod.nombre}"
                loading="lazy"
                width="350"
                height="197"
              />
            </div>
            <div class="product-info">
                <p>${prod.description}</p>
                <span class="btn">Ver detalles</span>
              </div>
            </article>
          `;
          grid.insertAdjacentHTML('beforeend', cardHtml);
        });

        if (countText) countText.textContent = `${productos.length} equipos encontrados`;
      } else {
        noProductsMsg?.classList.remove('hidden');
        if (countText) countText.textContent = '0 resultados';
      }
    } catch (err) {
      console.error("Error en la búsqueda:", err);
    }
  }

  // Listener con Debounce para no saturar la API
  searchInput?.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).value;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => search(value), 300) as unknown as number;
  });

  // Ejecutar búsqueda inicial vacía si deseas mostrar todo al cargar
  search('');
</script>