---

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { OrganizationSchema } from '../local-data/schemas';
import { BASE_URL, getMediaPermalink } from '../utils/config';
export interface Props {
  title: string;
  description: string;
  canonical: string; // Debe ser la URL absoluta
  image?: string; // Debe ser la URL absoluta de la imagen
  schemas?: any[]; // Array de schemas JSON-LD
  searchConsoleCode?:string
}

const {
  title,
  description,
  canonical,
  image = getMediaPermalink("/logo-claro.jpeg"), // Imagen por defecto para redes sociales
  schemas = [],
  searchConsoleCode = ''
} = Astro.props;

const siteName = "Mundo Minero LOS Reyes del Norte";
const formattedTitle = `${title} | ${siteName}`;

const company : OrganizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Mundo Minero Los Reyes del Norte',
  url: BASE_URL,
  logo: BASE_URL+'favicon.svg',
  sameAs: [
	'https://www.facebook.com/mmlosreyesdelnorte',
	'https://www.instagram.com/mmreyesdelnorte',
	'https://www.tiktok.com/@mmreyesdlnorte'
  ],
  description: 'Maquinaria y equipos para minería. MUNDO MINERO LOS REYES DEL NORTE, Lideres en equipos de extracción minera.',
  address: {
	'@type': 'PostalAddress',
	streetAddress: 'AV. AMERICA SUR Nro. 836',
	addressLocality: 'trujillo',
	addressRegion: 'La Libertad',
	postalCode: '',
	addressCountry: 'PE'
  },
  foundingDate: '2004-01-01'
};

schemas.push(company);

---
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- SEO Básico -->
<title>{formattedTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph (para Facebook, LinkedIn, etc.) -->
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content="website" />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={title} />

<!-- Twitter Card (para Twitter) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />

<!-- JSON-LD Schemas -->
{
  schemas.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />
  )
}

<!-- Favicon - Asegúrate de tener estos archivos en tu carpeta `public` -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="msapplication-TileColor" content="#004d99" />
<meta name="theme-color" content="#f9f9f9" />
	</head>
	<body>
		<Header />
    <slot />
		<Footer />
	</body>
</html>

<style is:global>
@view-transition {
  navigation: auto; /* Habilita la transición automática entre páginas del mismo dominio */
}

/* Personaliza la animación de salida y entrada */
::view-transition-old(root) {
  animation: fade-out 0.5s ease-in-out forwards;
}

::view-transition-new(root) {
  animation: fade-in 0.5s ease-in-out forwards;
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fade-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
	:root {
		--hheader: 80px;
		--light:#ffffff;
		--dark: #000000;
		--darkh: rgba(0, 0, 0, 0.7);
		--plata:rgb(105, 105, 105);
	}
@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
  :root {
    /* Podemos bajar un poco la saturación si el OLED es muy chillón */
    --dark: #000000; 
	--darkh: rgba(0, 0, 0, 0.6);
	--plata:rgba(129, 128, 128, 0.575);
  }
}
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}
	
	body::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -2; 
		background-color: var(--dark); 	
		}
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		letter-spacing: 0.05em;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		z-index: 1; 
		color:var(--light);
		background: transparent;
		font-family: Arial, Helvetica, sans-serif;
	}
	body::after {
			content: "";
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			width: 100%;
			height: 100%;
			will-change: transform; 
			z-index: -1; 
			background:  url(/9-16-1.webp) center no-repeat; 
			background-size:cover;
			}
	h1, h2, h3, h4, h5, h6 {
		line-height: 1.2;
		font-weight: lighter;
		letter-spacing: 0.08em;
		font-family: 'Times New Roman', Times, serif;
	}

	p {
		line-height: 1.6;
	}

	a {
		color: inherit;
		text-decoration: none;
	}
	
	svg.whatsapp {
		flex-shrink: 0;
		color: #25d366;
	}
	.nav-icons{stroke:white;}
	img {
		width: 100%;
		height: auto;
	}
.titulos{
		font-size: clamp(2rem, 4vw, 3.5rem);
		line-height: 1.2;
		text-transform: uppercase;
	}
	/* Header Styles */
	#header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
	}


	.navbar {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		height: var(--hheader);
	}

.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	.nav-links {
		display: flex;
		list-style: none;
		gap: 1rem;
		margin: 0;
		flex: 1;
		justify-content: center;
		align-items:center;
	}
	
	.nav-links a, .nav-links svg {
		text-decoration: none;
		position: relative;
		font-weight: 100;
		cursor:pointer;
		display:block;
	}
	.nav-links a{
		display:flex;
		flex-flow:row;
		padding:.15rem .2rem;
	}
	.nav-links a svg{
		margin-right:10px;
	}
	.btn {
		width: max-content;
		display: flex;
		align-items: center;
		justify-content: center;
		outline: none;
		border: 1px solid var(--plata);
		padding: 0.5rem 1rem;
		border-radius: 7px;
		transition: transform 0.3s ease;
		margin:auto;
		min-width: 150px;
	}

	.btn:hover {
		transform: translateY(-2px);
		background: var(--plata);
		color: var(--dark);
	}

	.btn svg {
		margin-right: 0.5rem;
	}
	/* Footer Styles */
	footer {
		padding: 4rem 2rem 2rem;
		background: var(--darkh);
		backdrop-filter: blur(10px);
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.footer-section h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	.footer-section h4 {
		font-size: 1.125rem;
		margin-bottom: 1rem;
	}

	.footer-section p {
		line-height: 1.6;
		margin: 0.5rem 0;
	}

	.footer-section ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-section li {
		margin-bottom: 0.75rem;
	}

	.footer-section a {
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.footer-bottom {
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		text-align: center;
	}

	.footer-bottom p {
		margin: 0;
	}
@media (min-width: 768px) {
	body::after { 
			background:  url(/16-9-1.webp) center no-repeat; 
			background-size:cover;
	}
}
</style>