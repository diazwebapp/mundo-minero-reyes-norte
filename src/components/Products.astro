---
import { categorias } from '../local-data/database.ts';
import { Image } from 'astro:assets';

---

<section id="productos">
	
	<div class="section-header">
		<h2 class="section-label">Productos</h2>
		<p class="subtitle">
			Explora nuestro catálogo de maquinaria pesada, equipos y accesorios diseñados para superar los
			desafíos más exigentes de la industria.
		</p>
	</div>

		<div class="categories-grid">
			{categorias.map(categoria => (
				<div class="category-section">

					<div class="image-container">
						<Image src={categoria.imagen} alt={categoria.nombre} loading="lazy" width={200} height={200} />
					</div>
					<h3>{categoria.nombre}</h3>
					<a href={categoria.slug} class="btn">Ver todos →</a>
				</div>
			))}
		</div>
	
</section>

<style>
	#productos {
		padding: 5rem 2rem;
	}
	.subtitle, h2{
		padding:2rem 1rem;
		text-align:center;
	}
	h2 {
		padding-bottom:0;
	}


	.categories-grid {
		display: flex;
		flex-flow: row wrap;
		justify-content: center;
		gap: 2rem;
	}

	.category-section {
		padding: 1.5rem;
		border-radius: 16px;
		box-shadow: 0px 0px 2px var(--plata);
		backdrop-filter: blur(5px);
		background-color: var(--darkh);
	}
	.category-section h3 {
		margin: 1rem 0;
	}

	.image-container {
		position: relative;
		width: 200px;
		height: 200px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0 auto;
	}
	
</style>

