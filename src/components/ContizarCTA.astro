---

import { Icon } from "astro-icon/components"
import { fichaTecnica } from "../local-data/ficha-tecnica"

type Props = {
    nombreArticulo?:string
    textAlt?:string
}

const {nombreArticulo,textAlt} = Astro.props as Props

const text = textAlt ? textAlt:"Hola, estoy interesado en el producto: " + nombreArticulo ? nombreArticulo : ''
---
<div class="cta-section">
    <h3>Cotización Gratis</h3>
    <a href={`mailto:${fichaTecnica.datos_contacto.correo_electronico}`} class="btn btn-light">
        <Icon name="lucide:mail" size={24}/>
        E-mail
    </a>
    <a href={`https://api.whatsapp.com/send?phone=${fichaTecnica.datos_contacto.whatsapp?.replace(/\D/g, '') || '51920310887'}&text=${text}`} class="btn btn-secondary">
        <Icon name="simple-icons:whatsapp" size={24} color="#25d366" />
        WhatsApp
    </a>
</div>

<style>
    .cta-section { padding: .6rem; display: flex; flex-flow:row wrap; gap:1rem; border-bottom: 1px solid #e74c3c; }
    .cta-section h3 { font-size: 1.3rem; width: 100%; margin: 0 0 0.5rem 0; text-align:center; }
    .btn{ margin-top: 0.5rem; }
    .btn-light{ background-color: var(--light); color:var(--dark); }
</style>