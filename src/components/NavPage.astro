---
import { navItems } from "../local-data/database"; 
import { getPermalink } from "../utils/config";
---
<ul class="nav-links">
    <!-- <li><a aria-label="Inicio" href="/">Inicio</a></li> -->
    <li><a aria-label="Productos" href="/#productos">Productos</a></li>
	{navItems.map(item => {
		const permalink = getPermalink([item.slug],true);
		return (
		<li><a aria-label={item.nombre} href={permalink}>{item.nombre}</a></li>
	)})}
	
	<li><a aria-label="Contacto" href="/nosotros#contacto">Contacto</a></li>

	<li><a href="/search" aria-label="Buscar producto" title="Buscar producto">
		<svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="none" viewBox="0 0 24 24"  class="nav-icons">
	
			<circle cx="10.5" cy="10.5" r="6.5" stroke-linejoin="round"/>
			<path d="M19.6464 20.3536C19.8417 20.5488 20.1583 20.5488 20.3536 20.3536C20.5488 20.1583 20.5488 19.8417 20.3536 19.6464L19.6464 20.3536ZM20.3536 19.6464L15.3536 14.6464L14.6464 15.3536L19.6464 20.3536L20.3536 19.6464Z" fill="#000000"/>
	
		</svg>
	</a>
	</li>
</ul>