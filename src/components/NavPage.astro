---
import { Icon } from 'astro-icon/components';
---
<nav class="navbar">
	<ul class="nav-links">
		<li>
			<a aria-label="Inicio" href="/">
				<Icon name="lucide:home" size={24}/>
				<p>inicio</p>
			</a>
		</li>
		<li>
			<a aria-label="Productos" href="/#productos">
				<Icon name="lucide:shopping-bag" size={24} />
				<p>productos</p>
			</a>
		</li>
		<li>
			<a aria-label="Repuestos" href="/repuestos/">
				<Icon name="lucide:wrench" size={24} />
				<p>repuestos</p>
			</a>
		</li>
		<li>
			<a aria-label="Contacto" href="/nosotros/#contacto">
				<Icon name="lucide:phone" size={24} />
				<p>contacto</p>
			</a>
		</li>

		<li>
			<a href="/search" aria-label="Buscar producto" title="Buscar producto">
				<Icon name="lucide:search" size={24} />
			</a>
		</li>
	</ul>
</nav>
<style>
	.navbar {
		width:100%;
		max-width: 1200px;
		margin: 0 auto;
		height: var(--hheader);
		place-content:center;
	}
	.nav-links {
		display: flex;
		list-style: none;
		gap: 1rem;
		justify-content: space-around;
	}
	.nav-links a{
		display:flex;
		align-items:center;
		gap:1rem;
		text-transform:uppercase;
	}
	.nav-links a p{
		display:none;
	}
	@media (min-width: 880px) {
		.navbar{
			width:fit-content;
		}
		.nav-links a{
			gap: 0.3rem;
		}
		.nav-links a p{
			display:block;
		}
	}
</style>