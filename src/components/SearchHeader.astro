---
import { Icon } from 'astro-icon/components';
---
<header id="header">
  <div class="container searchbar">

    
        <a href="/" aria-label="Volver"><Icon name="lucide:arrow-left" size={24}/></a>

        
        <input 
            type="text" 
            id="main-search" 
            placeholder="Buscar por nombre o característica..." 
            autocomplete="off"
        />
  </div>
</header>

<style>
    #header{
		background:linear-gradient(180deg, var(--darkh) 50%, rgba(0,0,0,.05) 100%);
		backdrop-filter: blur(10px);
	}
  .searchbar{
    height:var(--hheader);
    padding: 1rem;
    display:flex;
    place-content:space-between;
    place-items:center;
  }
 

  input {
    padding: 0.7rem 1rem;
    border-radius: 8px;
    border: 1px solid #333;
    background: #111;
    color: #fff;
    font-size: 1rem;
    transition: all 0.2s;
  }

  input:focus { border-color: #f39c12; outline: none; background: #000; }
</style>