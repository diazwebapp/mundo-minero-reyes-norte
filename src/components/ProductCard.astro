---
import type { Categoria, Producto } from '../local-data/database.types';
import { Image } from 'astro:assets';

interface Props {
  producto: Producto | Categoria;
  categorySlug?: string;
}

const { producto, categorySlug } = Astro.props as Props;

/**
 * discriminador: sólo los `Producto` tienen `categoria_id`
 */
function isProducto(x: Producto | Categoria): x is Producto {
  return (x as Producto).categoria_id !== undefined;
}
function isCategory(x: Producto | Categoria): x is Categoria {
  return (x as Categoria).id !== undefined;
}
---

<article class="product-card">
  <a
    href={`/${categorySlug ? `${categorySlug}` : ''}${producto.slug}`}
    class="stretched-link"
    aria-label={`Ver detalles de ${producto.nombre}`}
  >
    <span class="sr-only">Ver detalles de {producto.nombre}</span>
  </a>

  <div class="product-image">
    <Image
      src={producto.imagen_portada}
      alt={producto.nombre}
      title={producto.nombre}
      loading="lazy"
      width={350}
      height={197}
    />
  </div>

  <div class="product-info">
    <strong class="product-model">{producto.nombre}</strong>

    {/* sólo mostramos las specs cuando sea un Producto real */}
    {!categorySlug && isProducto(producto) && (
      <ul class="product-specs">
        {producto.motor?.tipo && (
          <li><strong>Motor:</strong> {producto.motor.tipo}</li>
        )}
        {producto.motor?.potencia && (
          <li><strong>Potencia:</strong> {producto.motor.potencia}</li>
        )}
        
      </ul>
    )}
  {!categorySlug && isCategory(producto) && (
    <p>{producto.description}</p>
  )}
    <span class="btn">Ver detalles</span>
  </div>
</article>

<style>
  .product-card {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 8px var(--plata);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(10px);
    position: relative;
  }
.product-image {
		position: relative;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0 auto;
	}

  .product-image img{
    aspect-ratio: 16/9;
  }
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 1px 2px var(--dark);
  }

  .product-info {
    padding: .8rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-model {
    margin: 0 0 .7rem 0;
  }

  .product-specs {
    list-style: none;
    padding: 0;
    margin: 0 0 .7rem 0;
    flex-grow: 1;
  }

  .product-specs li {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }
/* overlay anchor covering card */
.stretched-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* no visible content – aria-label above handles accessibility */
}

.btn {
    position: relative;
    z-index: 2;
    pointer-events: none; /* allow overlay link to receive clicks */
}
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>