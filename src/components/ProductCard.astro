---
import type { Producto } from '../local-data/database.types';
import { BASE_URL } from './slugify';
import { Image } from 'astro:assets';

interface Props {
  producto: Producto;
  categorySlug: string;
}

const { producto, categorySlug } = Astro.props;
---

<div class="product-card">
  <div class="product-image">
				<Image src={producto.imagen_portada} alt={producto.nombre} title={producto.nombre} loading="lazy" width={250} height={250} />
  </div>
  <div class="product-info">
    <h4 class="product-model">{producto.nombre}</h4>
    <ul class="product-specs">
      {producto.motor?.tipo && <li><strong>Motor:</strong> {producto.motor.tipo}</li>}
      {producto.motor?.potencia && <li><strong>Potencia:</strong> {producto.motor.potencia}</li>}
    </ul>
    <a href={`${BASE_URL}${categorySlug}/${producto.slug}/`} class="btn-details">Ver detalles</a>
  </div>
</div>

<style>
  .product-card {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 8px var(--plata);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    background-color: var(--darkh);
  }
.product-image {
		position: relative;
		width: 260px;
		height: 260px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0 auto;
	}
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 14px var(--dark);
  }

  .product-info {
    padding: .8rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-model {
    margin: 0 0 .7rem 0;
  }

  .product-specs {
    list-style: none;
    padding: 0;
    margin: 0 0 .7rem 0;
    flex-grow: 1;
  }

  .product-specs li {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .btn-details {
    display: inline-block;
    text-align: center;
    padding: 0.75rem 1.5rem;
    background-color: #e74c3c;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .btn-details:hover {
    background-color: #c0392b;
  }
</style>