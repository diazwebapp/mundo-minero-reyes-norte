---
import { fichaTecnica } from "../local-data/ficha-tecnica";
import { Image } from 'astro:assets';
import NavPage from "./NavPage.astro";
import { Icon } from "astro-icon/components";

---

<header id="header">
	<div class="container">
		<a href="/" class="logo" title="Ir a la página de inicio">
			<Image src={"/white-blue-logo.png"} title="Mundo Minero Reyes Norte" alt="Mundo Minero Reyes Norte" width="100" height="100" />
		</a>
		<NavPage/>
		<div class="nav-contact">
			<a href={`https://wa.me/`+fichaTecnica.datos_contacto.telefono_ventas} class="btn" target="_blank" rel="noopener">
				<Icon name="simple-icons:whatsapp" size={24} color="#25d366" />
				{fichaTecnica.datos_contacto.telefono_ventas}
			</a>
		</div>
	</div>
</header>

<style>
	.container{
		padding: 0 0.7rem;
	}
	#header{
		background:linear-gradient(180deg, var(--darkh) 50%, rgba(0,0,0,.05) 100%);
		backdrop-filter: blur(10px);
	}
	
	.nav-contact{
		display:none;
	}
	.logo {
		display: none;
	}
	@media (min-width: 768px) {
		.container{
			display:flex;
			align-items:center;
		}
		.logo {
			display: block;
			width: 80px;
		}
		.nav-contact {
			display: flex;
			align-items: center;
		}
	}
</style>