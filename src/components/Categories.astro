---
import { supabaseClient } from '../lib/supabase';
import ProductCard from './ProductCard.astro';

const { data: categoriasFilter, error } = await supabaseClient
  .from('categorias')
  .select('*')
  .eq('show', true)
  .is('parent_id', null)
  .order('id', { ascending: true });

if (error) {
  console.error("Error fetching categories:", error.message);
}
---

<section id="productos" class="container">
	
	<div class="section-header">
		<h2 class="titulos" >Maquinaria para la industria minera</h2>
		<p class="subtitle">
			Reduzca costos operativos y garantice la seguridad de su equipo con maquinaria probada en las condiciones mineras más exigentes. Descubre las herramientas y equipos esenciales que impulsan la minería moderna
		</p>
	</div>

		<div class="categories-grid">
			{categoriasFilter?.map(categoria => (
				<ProductCard producto={categoria} />
			))}
		</div>
	
</section>

<style>
	
	#productos {
		padding: 4rem 0.7rem;
	}
	.subtitle, h2{
		padding:2rem 0.5rem;
		text-align:center;
	}
	


	.categories-grid {
		display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
	}

</style>

