---
import type { Categoria } from '../local-data/database.types';
import { Image } from 'astro:assets';
import { BASE_URL } from './slugify';

interface CategoriesProps {
	categories: Categoria[];
}

const { categories } = Astro.props as CategoriesProps;
---

<section id="productos">
	
	<div class="section-header">
		<h2 class="section-label">Productos</h2>
		<p class="subtitle">
			Categorías de maquinaria y equipos de mineria.
		</p>
	</div>

		<div class="categories-grid">
			{categories.map(categoria => (
				<div class="category-section">

					<div class="image-container">
						<Image src={categoria.imagen} title={categoria.nombre} alt={categoria.nombre} loading="lazy" width={280} height={280} />
					</div>
					<h3>{categoria.nombre}</h3>
					<a href={`${BASE_URL}${categoria.slug}/`} class="btn">Ver todos →</a>
				</div>
			))}
		</div>
	
</section>

<style>
	#productos {
		padding: 4rem 0.7rem;
	}
	.subtitle, h2{
		padding:2rem 0.5rem;
		text-align:center;
	}
	h2 {
		padding-bottom:0;
	}


	.categories-grid {
		display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
		gap: 1rem;
	}

	.category-section {
		padding: 0.7rem;
		border-radius: 16px;
		box-shadow: 0px 0px 2px var(--plata);
		backdrop-filter: blur(5px);
		background-color: var(--darkh);
	}
	.category-section h3 {
		margin: 1rem 0;
		text-align: center;
	}

	.image-container {
		position: relative;
		width: 300px;
		height: 300px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0 auto;
	}
	
</style>

