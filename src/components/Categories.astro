---
import type { Categoria } from '../local-data/database.types';
import { Image } from 'astro:assets';
import { BASE_URL } from './slugify';
import ProductCard from './ProductCard.astro';

interface CategoriesProps {
	categories: Categoria[];
}

const { categories } = Astro.props as CategoriesProps;
---

<section id="productos" class="container">
	
	<div class="section-header">
		<h2>Nuestras categorías</h2>
		<p class="subtitle">
			Diseñados para optimizar tus operaciones mineras. Desde excavadoras robustas hasta trituradoras eficientes, cada categoría ofrece soluciones especiales
		</p>
	</div>

		<div class="categories-grid">
			{categories.map(categoria => (
				<ProductCard producto={categoria} />
			))}
		</div>
	
</section>

<style>
	
	#productos {
		padding: 4rem 0.7rem;
	}
	.subtitle, h2{
		padding:2rem 0.5rem;
		text-align:center;
	}
	h2 {
		padding-bottom:0;
		font-size: 5rem;
	}


	.categories-grid {
		display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
	}

	.category-section {
		padding: 0.7rem;
		border-radius: 16px;
		box-shadow: 0px 0px 2px var(--plata);
		backdrop-filter: blur(5px);
	}
	.category-section h3 {
		margin: 1rem 0;
		text-align: center;
	}

	.image-container {
		position: relative;
		width: 260px;
		height: 260px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0 auto;
	}
	
</style>

