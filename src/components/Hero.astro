---
import { fichaTecnica } from "../local-data/ficha-tecnica";
const {informacion_general} = fichaTecnica
---

<section id="hero">
	<div class="hero-content">
			<h1>Maquinaria y equipos para minería</h1>

			<p class="hero-subtitle">
				{informacion_general.nombre_corto}, Lideres en equipos de extracción minera.
			</p>
			
			<a href="#productos" class="btn">Ver Productos</a>
			
	</div>
</section>

<style>
	#hero {
		height: calc(100vh - var(--hheader));
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 0 1rem;
		position: relative;
		z-index: 3;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-weight: 700;
		line-height: 1.2;
		text-transform: uppercase;
		/* Graduado de plata metálica */
  background: linear-gradient(
    to bottom,
    #202020 0%,
    #ffffff 55%,
    #1d1d1d 100%
  );

  display: inline; 

  /* Aplicación al texto */
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  
  /* Sombra para dar volumen (Efecto biselado) */
  filter: drop-shadow(1px 2px 0px var(--dark)) 
          drop-shadow(-1px -2px .5px var(--dark));
	}

	#hero p{
		margin: 2rem 0;
		font-size: clamp(1rem, 2vw, 1.4rem);
	}

	.btn{
		position:absolute;
		left:0;
		right:0;
		bottom: 20vh;
		background: var(--plata);
	}

	@media (max-width: 768px) {
		

	

	}
</style>
