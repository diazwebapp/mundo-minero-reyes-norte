---
import { fichaTecnica } from "../local-data/ficha-tecnica";
const {informacion_general} = fichaTecnica
---

<section id="hero">
	<div class="hero-content">
			<h1>Equipos de Minería de Alta Resistencia para Operaciones de Extracción Críticas</h1>

			<p class="hero-subtitle">
				{informacion_general.nombre_corto}, Lideres en equipos de extracción minera.
			</p>
			
			<a href="#productos" class="btn btn-primary">Ver Productos</a>
			
	</div>
</section>

<style>
	#hero {
		height: calc(100vh - var(--hheader));
		color: white;
		background: rgba(0, 0, 0, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 0 1rem;
	}
	.hero-text {
		max-width: 700px;
	}

	h1 {
		font-size: clamp(2rem, 3vw, 3.5rem);
		font-weight: 700;
		line-height: 1.2;
		margin-bottom: 1.5rem;
		background: linear-gradient(135deg, #ffffff 0%, #e0e0e0 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1rem;
		line-height: 1.3;
		margin-bottom: 2rem;
		color: rgba(255, 255, 255, 0.9);
	}



	@media (max-width: 768px) {
		#hero {
			min-height: 70vh;
		}

	

	}
</style>
