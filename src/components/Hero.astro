---
import { fichaTecnica } from "../local-data/ficha-tecnica";
const {informacion_general} = fichaTecnica
---

<section id="hero">
	<div class="hero-content">
			<h1>Maquinaria y equipos para minería</h1>

			<p class="hero-subtitle">
				{informacion_general.nombre_corto}, Lideres en equipos de extracción minera.
			</p>
			
			<a href="#productos" class="btn">Ver Productos</a>
			
	</div>
</section>

<style>
	#hero {
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 0 1rem;
		position: relative;
		z-index: 3;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3.5rem);
		line-height: 1.2;
		text-transform: uppercase;
	}

	#hero p{
		margin: 2rem 0;
		font-size: clamp(1rem, 2vw, 1.4rem);
	}

	.btn{
		background: var(--plata);
	}

	@media (max-width: 768px) {
		

	

	}
</style>
